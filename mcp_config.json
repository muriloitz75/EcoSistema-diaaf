{
    "mcpServers": {
        "ecosistema-diaaf": {
            "version": "1.0.0",
            "tools": [
                {
                    "name": "fiscal_search",
                    "description": "Busca códigos ISS e CNAE no banco de dados fiscal. Aceita descrição, item da LC (07.02), código de tributação nacional da NFS-e (07.02.01), NBS (1.0101.11.00, só no modo all) ou CNAE. Retorna item da LC, CNAE, descrições, alíquota, local de incidência do ISS (art. 3º da LC 116/2003), os códigos de tributação nacional do subitem, as NBS correlacionadas ao subitem e a atividade do Simples Nacional (Anexo III, IV, Fator R ou impeditiva). NBS e Simples por subitem vêm do Anexo VIII, preliminar: ver avisoNbs e avisoSimplesNacional. Também informa se o CNAE é impeditivo, ambíguo ou não impeditivo ao Simples (simplesNacionalCnae, Res. CGSN 140/2018, Anexos VI e VII, norma em vigor).",
                    "inputSchema": {
                        "type": "object",
                        "properties": {
                            "query": {
                                "type": "string",
                                "description": "Termo de busca (ex: 'TI', 'transp', '62.01-5')"
                            },
                            "limit": {
                                "type": "integer",
                                "description": "Número máximo de resultados (1 a 100)",
                                "default": 10
                            },
                            "mode": {
                                "type": "string",
                                "enum": ["all", "text", "lc", "cnae"],
                                "description": "Onde pesquisar: tudo, só descrições, só item da LC ou só CNAE",
                                "default": "all"
                            }
                        },
                        "required": [
                            "query"
                        ]
                    }
                },
                {
                    "name": "user_admin",
                    "description": "Gerencia usuários do sistema, permitindo aprovação, bloqueio e reset de senha.",
                    "inputSchema": {
                        "type": "object",
                        "properties": {
                            "action": {
                                "type": "string",
                                "enum": [
                                    "approve",
                                    "block",
                                    "unblock",
                                    "reset_password"
                                ],
                                "description": "Ação administrativa a ser realizada"
                            },
                            "userId": {
                                "type": "string",
                                "description": "ID único do usuário"
                            }
                        },
                        "required": [
                            "action",
                            "userId"
                        ]
                    }
                }
            ],
            "resources": [
                {
                    "uri": "audit://logs/recent",
                    "name": "Recent Audit Logs",
                    "description": "Últimos eventos de auditoria e segurança do sistema.",
                    "mimeType": "application/json"
                }
            ]
        }
    }
}